# PostgreSQL username used by Docker Compose and the backend container.
POSTGRES_USER=user

# PostgreSQL password for the local development database.
POSTGRES_PASSWORD=password

# Name of the PostgreSQL database created at startup.
POSTGRES_DB=steam_db

# Path to the Firebase Admin SDK service account key.
# For local offline development with USE_FIREBASE_EMULATOR=true, you can leave the default dummy key.
# For Live Firebase Cloud Console mode, set this to the absolute path of your real serviceAccountKey.json.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./dummy-service-account.json

# Toggle to use local Firebase Auth Emulator in backend (true) or live Firebase project (false).
USE_FIREBASE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
FIREBASE_PROJECT_ID=gamelog-40e10

# Toggle to enable/disable background sync jobs in FastAPI (true/false).
# Can be overridden dynamically by running Makefile commands with the 'prod' goal.
RUN_SCHEDULER=false

# Steam API Keys for specific seed users
# If specific keys are not set, the default key is used.
DEFAULT_STEAM_API_KEY=
DEDEPIVOT_STEAM_API_KEY=
XRAYMAN_STEAM_API_KEY=
SLAITROC_STEAM_API_KEY=
