# Steam API key used only by Steam provider endpoints.
# Leave a real value here if you want to run the app against Steam APIs.
EXPO_PUBLIC_STEAM_API_KEY=YOUR_STEAM_API_KEY

# Backend base URL used by the backend provider.
# - Web / local machine: http://localhost:8000
# - Android emulator / Waydroid / device on the LAN: http://<YOUR_HOST_IP>:8000
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# Optional default provider when running `npm run start` directly.
# Allowed values: steam | backend
EXPO_PUBLIC_API_PROVIDER=steam

# Firebase client configuration used by src/auth/firebaseClient.ts.
# These values are project identifiers (not server-side secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# Optional
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Test Firebase user used by the Dev View token generator.
EXPO_PUBLIC_TOKEN_GEN_EMAIL=YOUR_TEST_USER_EMAIL
EXPO_PUBLIC_TOKEN_GEN_PASSWORD=YOUR_TEST_USER_PASSWORD

# Temporary Firebase ID token copied from the Dev View console after generation.
# Paste the generated token here, then restart Expo.
EXPO_PUBLIC_TEST_BEARER_TOKEN=YOUR_GENERATED_FIREBASE_ID_TOKEN
