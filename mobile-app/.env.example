# EXPO_PUBLIC_IS_DEV controls whether to use development features like dynamic service discovery
EXPO_PUBLIC_IS_DEV=true

# Backend & Firebase Fallback Map:
# When EXPO_PUBLIC_IS_DEV=true and these variables are left empty,
# the app will automatically ping and assign the correct host per platform:
# - ios:     localhost
# - android: 10.0.2.2 (Android Studio) -> 192.168.240.1 (Waydroid) -> localhost
# - web:     localhost
# In production (EXPO_PUBLIC_IS_DEV=false), these MUST be explicitly set or it will fail.
EXPO_PUBLIC_BACKEND_BASE_URL=
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Toggle to use local Firebase Auth Emulator (true) or live Firebase project (false).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase client configuration used by src/auth/firebaseClient.ts.
# These values are public client identifiers (not backend/admin secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAVGPT6CKyiS_HmeGg_i0K7GH8qzSGpCWc
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gamelog-40e10.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gamelog-40e10
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=gamelog-40e10.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=799231800910
EXPO_PUBLIC_FIREBASE_APP_ID=1:799231800910:web:3cf45b5a0d3ef6c763b51f
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-F1K0LBQR4X

# Default test Firebase user used by the Dev View token generator.
EXPO_PUBLIC_TOKEN_GEN_EMAIL=test-01@test.com
EXPO_PUBLIC_TOKEN_GEN_PASSWORD=12345678

# Web Client ID (client_type: 3) for Google OAuth Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=799231800910-coul5brdbsfglpgj41n2nsufedt1ju5p.apps.googleusercontent.com
