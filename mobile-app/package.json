{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:fresh": "expo start --go -c",
    "start:steam": "cross-env EXPO_PUBLIC_API_PROVIDER=steam expo start --go",
    "start:backend": "cross-env EXPO_PUBLIC_API_PROVIDER=backend expo start --go",
    "android": "expo run:android",
    "android:steam": "cross-env EXPO_PUBLIC_API_PROVIDER=steam expo run:android",
    "android:backend": "cross-env EXPO_PUBLIC_API_PROVIDER=backend expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:steam": "cross-env EXPO_PUBLIC_API_PROVIDER=steam expo start --web",
    "web:backend": "cross-env EXPO_PUBLIC_API_PROVIDER=backend expo start --web",
    "prettier": "prettier --check '**/*.{ts,tsx}'",
    "prettier:fix": "prettier --write '**/*.{ts,tsx}'",
    "lint": "expo lint -- --ext .ts,.tsx .",
    "lint:fix": "expo lint -- --ext .ts,.tsx . --fix",
    "test": "jest --watchAll"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-config": "~55.0.9",
    "@gluestack-ui/core": "^3.0.13",
    "@gluestack-ui/utils": "^3.0.17",
    "@gluestack/ui-next-adapter": "^3.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/ionicons": "^12.4.1",
    "@react-native-vector-icons/material-design-icons": "^12.4.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~55.0.4",
    "expo-dev-client": "~55.0.13",
    "expo-font": "~55.0.4",
    "expo-image": "^55.0.6",
    "expo-linear-gradient": "~55.0.9",
    "expo-router": "^55.0.7",
    "expo-status-bar": "~55.0.4",
    "firebase": "^12.12.1",
    "nativewind": "^4.2.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native": "^0.83.2",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.7.4",
    "react-refresh": "^0.18.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.2.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "./__mocks__/styleMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|tailwind-variants|@gluestack-ui|@gluestack-style|react-native-css-interop|lucide-react-native)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/__ignore/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!eslint.config.js",
      "!jest.config.js",
      "!**/metro.config.js",
      "!**/nativewind-env.d.ts",
      "!**/tailwind.config.js",
      "!index.ts",
      "!**/App.tsx",
      "!**/_ignore/**",
      "!**/types/**",
      "!**/src/dev/**",
      "!**/src/auth/firebaseClient.ts",
      "!**/src/utils/**",
      "!**/src/common/index.ts",
      "!**/src/common/gluestack/**",
      "!**/src/theme/index.ts",
      "!**/src/routes.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  },
  "private": true
}
