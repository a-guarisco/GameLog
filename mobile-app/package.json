{
  "name": "gamelog",
  "version": "2.0.0-rc.22-1772685434143",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "upgrade:tamagui": "bunx npm-check-updates -u '*tamagui*' '@tamagui/*' && bun install",
    "start": "bunx expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "bunx jest --watchAll",
    "test:e2e": "bunx playwright test",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "prettier": "prettier --check '**/*.{ts,tsx,js,jsx}'",
    "prettier:fix": "prettier --write '**/*.{ts,tsx,js,jsx}'"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-navigation/native": "^7.0.14",
    "@tamagui/config": "^2.0.0-rc.22",
    "@tamagui/lucide-icons": "^2.0.0-rc.22",
    "@tamagui/toast": "^2.0.0-rc.22",
    "babel-preset-expo": "~54.0.0",
    "burnt": "^0.12.2",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.9",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "react": ">=19",
    "react-dom": "*",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "^2.0.0-rc.22"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-config": "~54.0.2",
    "@expo/metro-runtime": "~6.1.2",
    "@playwright/test": "^1.49.1",
    "@tamagui/babel-plugin": "^2.0.0-rc.22",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "~29.7.0",
    "jest-expo": "^55.0.9",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "serve": "^14.2.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__test__/unit/**/*.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|tamagui|@tamagui/.*)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "theme/**/*.{ts,tsx}",
      "!app/_layout.tsx",
      "!app/+html.tsx",
      "!app/+not-found.tsx",
      "!**/_nocoverage/**",
      "!**/_ignore/**",
      "!**/*.nocov.{ts,tsx}",
      "!**/*.sample.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  },
  "packageManager": "bun@1.3.9"
}
